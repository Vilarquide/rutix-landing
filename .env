# ============================================================
#  DATOS DE LA LANDING
#  Copia este fichero a .env y rellena tus valores.
#  No hace falta "export": es un .env normal.
#  Si un valor empieza o acaba en comilla, envuélvelo en comillas simples.
# ============================================================

# ---------- OBLIGATORIAS (el build se para si faltan) ----------

# Nombre de la aplicación. Sale en la pestaña del navegador, el menú,
# la comparativa "con/sin", las redes y el copyright.
APP_NAME=Rutix

# Nombre legal de la empresa para el pie: © 2026 Tu Empresa S.L.
COMPANY_NAME=Rutix
# Email de contacto. Sale en los botones de email (2 sitios).
EMAIL=info@rutix.es

# Teléfono visible (con espacios) y versión E.164 para el enlace tel: (sin espacios).
PHONE=635 854 034
PHONE_E164=+34635854034

# Dirección postal del pie.
ADDRESS= Avenida de Glasgow
POSTCODE=15008
CITY=A Coruña
COUNTRY=España

# ---------- REDES (vacío = icono sin destino) ----------

LINKEDIN_URL=
X_URL=
GITHUB_URL=

# ---------- COLUMNA "RECURSOS" DEL PIE (vacío = enlace inactivo) ----------

URL_DOCS=
URL_API=
URL_STATUS=
URL_BLOG=

# ---------- BARRA LEGAL DEL PIE (vacío = enlace inactivo) ----------

URL_LEGAL=
URL_PRIVACY=
URL_COOKIES=

# ---------- FORMULARIO DE CONTACTO ----------

# Destino del formulario (Formspree, tu propia API…).
# Vacío = no envía nada; solo muestra FORM_MESSAGE al pulsar enviar.
FORM_ACTION=

# Mensaje de "gracias" tras enviar.
FORM_MESSAGE=¡Gracias! Te escribimos en breve.

# ---------- CABECERA <head> ----------

# Descripción para buscadores (meta description).
META_DESCRIPTION=Rutas de reparto y recogida optimizadas sobre carretera real, app de conductor con incidencias, agenda de flota, comparativa de ahorro y módulo de almacén. Se instala en tu servidor.

# Descripción al compartir en redes (Open Graph).
OG_DESCRIPTION=Optimización de rutas, gestión de flota y almacén para equipos de logística.

# Imagen al compartir en redes (recomendado 1200×630 px).
OG_IMAGE=assets/img/og-image.png

# Icono de la pestaña.
FAVICON=assets/img/favicon.svg
